<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BagsAndContents.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BagsAndContents"
    Shell.FlyoutBehavior="Flyout"
    Title="BagsAndContents">
    <Shell.FlyoutHeader>
        <ContentView>
            <Image Source="icon.jpg"/>
        </ContentView>
    </Shell.FlyoutHeader>
    <FlyoutItem Title="Режим просмотра" >
        <Tab>
            <ShellContent Title="Режим просмотра" ContentTemplate="{DataTemplate local:MainPage}" Route="Overview"/>
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Режим админа">
        <Tab>
            <ShellContent Title="Режим Администратора" ContentTemplate="{DataTemplate local:AdminPage}" Route="AdminMode"/>
        </Tab>
    </FlyoutItem>
    <FlyoutItem>
        <Tab>
            <ShellContent Title="test"/>
            <ShellContent/>
        </Tab>
    </FlyoutItem>
    <TabBar IsVisible="True">
        <Tab>
            <ShellContent Title="Авторизация" />
        </Tab>
        <Tab>
            <ShellContent Title="регистрация"/>
        </Tab>
        
    </TabBar>
</Shell>
