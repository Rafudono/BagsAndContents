<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BagsAndContents.NewContent"
             Title="NewContent">
    <VerticalStackLayout>
        <Label Text="Что вы хотите положить в сумку (пакет)?"/>
        <Entry  Text="{Binding NeWContent.Name}"/>
        <Label Text="Опишите этот предмет (необязательно)?"/>
        <Entry  Text="{Binding NeWContent.Description}"/>
        <Button Text="Положить в сумку!" Clicked="Save"/>
    </VerticalStackLayout>
</ContentPage>