<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BagsAndContents.ViewModel"
             x:Class="BagsAndContents.PersonalPage"
             Title="PersonalPage">
    <ContentPage.BindingContext>
        <local:PersonalPageVM/>
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label Text="Логин"/>
        <Entry Text="{Binding Person.Login}"/>
        <Label Text="Пароль"/>
        <Entry Text="{Binding Person.Password}"/>
        <Label Text="Имя пользователя"/>
        <Entry Text="{Binding Person.Name}"/>
        <Button Text="Сохранить" Clicked="Save"/>
    </VerticalStackLayout>
</ContentPage>