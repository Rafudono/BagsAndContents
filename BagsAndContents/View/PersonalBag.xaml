<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BagsAndContents.PersonalBag"
             Title="PersonalBag">
    <VerticalStackLayout>
        <Label Text="Ваша сумка (пакет)"/>
        <Entry  Text="{Binding MyBag.Type}"/>
        <Label Text="Содержимое сумки (пакета)"/>
        <ListView ItemsSource="{Binding MyBag.Contents}" SelectedItem="{Binding SelectedContent}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout>
                            <Label Text="{Binding Name}"/>
                            <Label Text="{Binding Description}"/>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="+ предмет в сумку" Clicked="NewContent"/>
        <Button Text="Выкинуть из сумки!" Clicked="DelContent"/>
        <Button Text="Упаковано!" Clicked="Confirm"/>
    </VerticalStackLayout>
</ContentPage>