<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BagsAndContents.AddContent"
             Title="AddContent">
    <VerticalStackLayout>
        <Label Text="Что это?"/>
        <Entry Text="{Binding NewContent.Name}"/>
        <Label Text="Добавьте описание! (необязательно)"/>
        <Entry Text="{Binding NewContent.Description}"/>
        <Button Text="Положить в сумку!" Clicked="AddNewContent"/>
    </VerticalStackLayout>
</ContentPage>